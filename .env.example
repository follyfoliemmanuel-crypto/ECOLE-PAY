# ---------------------------------------------------------------------------
# ECOLE PAY — variables d'environnement
# Copier ce fichier en `.env.local` puis remplir les valeurs.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (Neon, Supabase ou Postgres classique).
# Neon : Project → Connection string → "Pooled connection".
# En production, mettez la vraie URL dans les variables d'environnement de
# l'hébergeur, jamais dans ce fichier.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/ecolepay?sslmode=require"

# Clé secrète utilisée pour signer les sessions (minimum 32 caractères).
# Elle signe aussi les captchas anti-robot : ne la changez pas sans prévenir
# (les sessions et captchas en cours deviennent invalides).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"

# --- Super admin (activation des écoles) ------------------------------------
# Seul cet email peut ouvrir /super-admin. Changez le mot de passe en production.
SUPER_ADMIN_EMAIL="follyfoliemmanuel@gmail.com"
SUPER_ADMIN_PASSWORD="choisissez-un-mot-de-passe-de-12-caracteres-minimum"

# URL publique du site. Elle sert aux emails de réinitialisation ET aux liens
# du portail parent (/parent/nom-de-lecole) affichés au directeur, dans le
# message WhatsApp et dans le QR code. En production : https://ecolepay.tg
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (optionnel) ------------------------------------------------------
# Sans clé Resend, les emails ne sont pas envoyés : en développement le lien de
# réinitialisation s'affiche directement à l'écran.
# IMPORTANT : Resend refuse l'envoi tant que le domaine de EMAIL_FROM n'est pas
# vérifié (Domains → Add domain → SPF + DKIM + DMARC). Sans domaine vérifié,
# utilisez le sandbox "onboarding@resend.dev", qui n'écrit qu'à l'adresse du
# titulaire du compte Resend.
RESEND_API_KEY=""
EMAIL_FROM="ECOLE PAY <noreply@ecolepay.tg>"

# --- WhatsApp Cloud API (optionnel, offre PREMIUM) --------------------------
# Sans ces variables, la publication des bulletins reste fonctionnelle : le
# directeur obtient un lien wa.me par parent et envoie le message lui-même.
# Avec ces variables, le bulletin PDF part directement sur le WhatsApp du parent.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
# WHATSAPP_API_VERSION="v21.0"

# --- Application de bureau Windows -----------------------------------------
# Lien public du fichier .exe (affiché dans Paramètres → Application bureau).
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL="https://maj.ecolepay.tg/desktop/ECOLE-PAY-1.0.0-setup.exe"

# URL chargée par la coque Electron. En développement : le serveur local.
# En production, laisser vide pour utiliser https://app.ecolepay.tg.
# ECOLEPAY_APP_URL="http://localhost:3000"

# --- Coordonnées commerciales (facultatif) ---------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL="follyfoliemmanuel@gmail.com"
# NEXT_PUBLIC_CONTACT_WHATSAPP="22870309744"
# NEXT_PUBLIC_CONTACT_WHATSAPP_AFFICHAGE="+228 70309744"
# NEXT_PUBLIC_FLOOZ_NUMBER="+228 70309744"
# NEXT_PUBLIC_TMONEY_NUMBER="+228 70309744"
# NEXT_PUBLIC_MONEY_BENEFICIAIRE="ECOLE PAY SARL"
